generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Visibility {
  PUBLIC
  UNLISTED
  PRIVATE
}

enum UiTheme {
  BLACK
  CATPPUCCIN_FRAPPE
  CATPPUCCIN_LATTE
  CATPPUCCIN_MACCHIATO
  CATPPUCCIN_MOCHA
  DEFAULT
  DRACULA
  FIRE
  FOREST
  FROSTY
  GRUVBOX_DARK
  GRUVBOX_LIGHT
  ONE_DARK
  OCEAN
  ROSE_PINE
  ROSE_PINE_DAWN
  ROSE_PINE_MOON
  ROSE_STONE
  SOLARIZED_DARK
  TOKYONIGHT
  WHITE
}

model User {
  id          String           @id @default(cuid())
  username    String           @unique
  email       String?          @unique
  displayName String?
  passwordHash String?
  theme       UiTheme          @default(TOKYONIGHT)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  builds      Build[]
  published   CommunityBuild[]
  sessions    Session[]
}

model Build {
  id          String           @id @default(cuid())
  userId      String?
  name        String
  code        String
  summary     Json?
  visibility  Visibility       @default(PRIVATE)
  patchVersion String?
  buildMetadata Json?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  user        User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  published   CommunityBuild?
  rankings    MetaRanking[]
  battleAsA   BattleResult[]   @relation("BattleBuildA")
  battleAsB   BattleResult[]   @relation("BattleBuildB")
  battleWins  BattleResult[]   @relation("BattleWinner")

  @@index([userId, createdAt])
}

model CommunityBuild {
  id          String   @id @default(cuid())
  buildId     String   @unique
  userId      String?
  title       String
  description String?
  tags        String[]
  likes       Int      @default(0)
  visibility  Visibility @default(PUBLIC)
  patchVersion String?
  buildMetadata Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  build       Build    @relation(fields: [buildId], references: [id], onDelete: Cascade)
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

model MetaRanking {
  id           String   @id @default(cuid())
  buildId      String
  patchVersion String
  score        Float
  winRate      Float
  tier         String
  createdAt    DateTime @default(now())
  build        Build    @relation(fields: [buildId], references: [id], onDelete: Cascade)

  @@index([patchVersion, score])
  @@index([buildId, patchVersion])
}

model BattleResult {
  id            String   @id @default(cuid())
  buildAId      String
  buildBId      String
  winnerBuildId String?
  durationSec   Float
  summary       Json?
  createdAt     DateTime @default(now())
  buildA        Build    @relation("BattleBuildA", fields: [buildAId], references: [id], onDelete: Cascade)
  buildB        Build    @relation("BattleBuildB", fields: [buildBId], references: [id], onDelete: Cascade)
  winnerBuild   Build?   @relation("BattleWinner", fields: [winnerBuildId], references: [id], onDelete: SetNull)

  @@index([buildAId, createdAt])
  @@index([buildBId, createdAt])
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

/// Kept for compatibility with existing project metadata.
model AppMeta {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
